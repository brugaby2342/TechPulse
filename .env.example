# =============================================================
# TechPulse — Central Inteligente de Insights de Inovação
# .env.example
# =============================================================
# Este arquivo é um MODELO. Ele documenta quais variáveis de
# ambiente o projeto usa, mas não contém nenhum valor real.
#
# Este arquivo DEVE ser commitado no repositório GitHub.
# O arquivo .env (com os valores reais) NUNCA deve ser commitado
# — ele está listado no .gitignore.
#
# Uso principal destas variáveis no TechPulse: testes locais
# (ex.: scripts Node.js de exploração das APIs GNews/Airtable
# antes de configurar as chamadas dentro do Make.com).
# A automação em produção usa as conexões/variáveis de cenário
# do próprio Make.com, não este arquivo.
# =============================================================

# --- GNews API ---
# Chave necessária para consultar notícias de tecnologia.
# Obtida em: https://gnews.io/
GNEWS_API_KEY=sua_chave_gnews_aqui

# --- CoinGecko API ---
# Usada em modo keyless (sem autenticação) no plano gratuito.
# Deixe em branco a menos que você troque para um plano com chave.
COINGECKO_API_KEY=

# --- Airtable ---
# Personal Access Token com escopo somente leitura
# (data.records:read), usado pelo frontend para consultar
# os dados consolidados.
# ATENÇÃO: mesmo protegido aqui localmente, este token, quando
# usado em um frontend estático (GitHub Pages), fica visível
# no navegador de quem acessa o site — é um trade-off consciente
# documentado no escopo-techpulse.md, não uma falha de proteção
# deste arquivo.
AIRTABLE_PAT=seu_token_airtable_aqui
AIRTABLE_BASE_ID=id_da_sua_base_aqui

# --- Painel administrativo (TechPulse /configuracoes) ---
# Token Bearer estático usado para autorizar ações administrativas
# (ex.: alterar parâmetros de automação). Gere um valor longo e
# aleatório (ex.: UUID) e nunca reutilize senhas existentes.
ADMIN_BEARER_TOKEN=gere_um_token_longo_e_aleatorio_aqui
